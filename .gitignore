# 编译产物（用户自行编译）
scripts/bin/capture

# Python 虚拟环境与缓存
scripts/.venv/
win/scripts/.venv/
__pycache__/
*.pyc

# macOS
.DS_Store

# 会话录音残留（本地测试产物，勿入库）
*.log

# 本机 GPU 加速验证环境（本地专用，勿入库）
.gpu/

# 用户听课产出根：user/<使用者>/session/<时间>_<直播主题>/
# 每场完整产出（音频分块+转写稿+日志）都落这里，是「本地产出」，不入版本库；
# 结构规范见 user/README.md。
user/*/session/
